from typing import Any, Dict, NoReturn, Optional, Union

import httpx
from pydantic import BaseModel, Field

from honeyhive._clock import _get_or_stamp_call_time_ns


# Default production URL
DEFAULT_BASE_URL = "https://api.dp1.us.honeyhive.ai"


class APIConfig(BaseModel):
    model_config = {
        "validate_assignment": True
    }

    base_path: str = DEFAULT_BASE_URL
    verify: Union[bool, str] = True
    access_token: Optional[str] = None
    # Request timeout in seconds passed to the underlying httpx client. Defaults
    # to 5.0 to match httpx's own default (so behaviour is unchanged unless set).
    # Set to None to disable timeouts entirely.
    timeout: Optional[float] = 5.0

    def get_access_token(self) -> Optional[str]:
        return self.access_token

    def set_access_token(self, value: str):
        self.access_token = value

    def get_default_headers(self) -> Dict[str, str]:
        """Get default headers for API requests, including SDK metadata."""
        return {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "Authorization": f"Bearer {self.get_access_token() or ''}",
            "hh-client-version": _get_sdk_version(),
            "hh-client-language": "python",
            "hh-client-package": "honeyhive",
            "hh-client-timestamp": str(_get_or_stamp_call_time_ns()),
        }


def _get_sdk_version() -> str:
    """Get the SDK version for use in request headers."""
    try:
        from honeyhive import __version__

        return __version__
    except Exception:
        return "unknown"


_NOT_FOUND_HINT = "the resource does not exist or the API key lacks access to it"


class HTTPException(Exception):
    def __init__(
        self,
        status_code: int,
        message: str,
        *,
        server_message: Optional[str] = None,
        error_code: Optional[str] = None,
    ) -> None:
        self.status_code = status_code
        self.message = message
        self.server_message = server_message
        self.error_code = error_code
        super().__init__(f"{status_code} {message}")

    def __str__(self) -> str:
        return f"{self.status_code} {self.message}"


def _parse_error_body(response: httpx.Response) -> tuple[Optional[str], Optional[str]]:
    """Return the ``message`` and ``errorCode`` fields of an API error body.

    Bodies that are not JSON objects (e.g. an HTML page from a proxy) yield
    ``(None, None)``.
    """
    try:
        body = response.json()
    except ValueError:
        return None, None
    if not isinstance(body, dict):
        return None, None
    message = body.get("message")
    error_code = body.get("errorCode")
    return (
        message if isinstance(message, str) and message else None,
        error_code if isinstance(error_code, str) and error_code else None,
    )


def _raise_http_exception(operation_id: str, response: httpx.Response) -> NoReturn:
    server_message, error_code = _parse_error_body(response)
    message = f"{operation_id} failed with status code: {response.status_code}"
    if server_message:
        message += f": {server_message}"
    if response.status_code == 404:
        message += f" ({_NOT_FOUND_HINT})"
    raise HTTPException(
        response.status_code,
        message,
        server_message=server_message,
        error_code=error_code,
    )


def _serialize_query_params(
    params: dict[str, Any],
) -> list[tuple[str, Any]]:
    """Serialize query params, expanding lists with bracket notation.

    httpx passes a plain List value as a repeated bare key, e.g.
    ``ids=a&ids=b``.  The server-side Zod schema rejects a single-value
    list as "expected array, received string" because one bare key looks
    like a plain string to the parser.

    Bracket notation (``ids[]=a&ids[]=b``) always produces an array
    regardless of how many values are present, which is what Zod expects.
    """
    result: list[tuple[str, Any]] = []
    for key, value in params.items():
        if isinstance(value, list):
            for item in value:
                result.append((f"{key}[]", item))
        else:
            result.append((key, value))
    return result
